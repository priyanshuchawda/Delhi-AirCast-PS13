
digraph G {
  graph [
    fontname="Helvetica",
    bgcolor="white",
    pad="0.25",
    ranksep="0.55",
    nodesep="0.35",
    splines="spline",
    outputorder="edgesfirst"
  ];
  node [
    fontname="Helvetica",
    fontsize=11,
    shape=box,
    style="rounded,filled",
    fillcolor="#EEF3F8",
    color="#1B3A5F",
    fontcolor="#1B3A5F",
    penwidth=1.5,
    margin="0.18,0.12"
  ];
  edge [
    fontname="Helvetica",
    fontsize=9,
    color="#5B7A9D",
    penwidth=1.4,
    arrowsize=0.75
  ];

  rankdir=TB;
  labelloc="t";
  label="Figure. Each source has a clear job";
  fontsize=13;
  fontcolor="#1B3A5F";

  subgraph cluster_a {
    label="LABELS  (ground truth PM2.5)";
    color="#2E7D4F";
    fillcolor="#F3FAF7";
    style="rounded,filled";
    a1 [label="OpenCity CPCB concentrations", fillcolor="#E7F6EC"];
    a2 [label="OpenAQ CPCB measurements", fillcolor="#E7F6EC"];
  }
  subgraph cluster_b {
    label="FEATURES";
    color="#2C5F8A";
    fillcolor="#F7FAFC";
    style="rounded,filled";
    b1 [label="Open-Meteo weather", fillcolor="#D6E6F5"];
    b2 [label="calendar / Diwali window", fillcolor="#D6E6F5"];
    b3 [label="CAMS regional AQ  (auxiliary)", fillcolor="#FFF4E5"];
  }
  subgraph cluster_c {
    label="LIVE NOW  (dashboard)";
    color="#1B3A5F";
    fillcolor="#F7FAFC";
    style="rounded,filled";
    c1 [label="1. data.gov.in", fillcolor="#E7F6EC"];
    c2 [label="2. OpenAQ backup", fillcolor="#FFF4E5"];
    c3 [label="3. WAQI optional", fillcolor="#FFF4E5"];
  }
  a1 -> b1 [style=invis];

}
